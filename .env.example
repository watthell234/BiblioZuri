# Copy to .env.local for local development.
# Both values are safe to expose publicly (the publishable key is client-side by design).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Reading titles off cover photos needs an Anthropic API key. It is NOT a VITE_
# variable and must never be one: anything prefixed VITE_ is baked into the
# JavaScript the browser downloads. It lives only as a Supabase secret:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
